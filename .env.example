# 7 Horse Ventures — Environment Configuration Template
PORT=5000
NODE_ENV=production

# Security & Session Authentication
JWT_SECRET=7h-ventures-secure-production-jwt-hmac-key-2026

# Administrator Bootstrap
ADMIN_EMAIL=admin@7horseventures.com
ADMIN_PASSWORD=7horse2026

# Community Integrations
OFFICIAL_WHATSAPP_LINK=https://chat.whatsapp.com/IzTObDPm8pw80Hw811RJvC?s=cl&p=a&iam=2

# Supabase Cloud Database
# When set, the system automatically synchronizes all 20 collections to Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Cashfree Payment Gateway (UPI, Cards, Netbanking)
# Get credentials from Cashfree Merchant Dashboard: https://merchant.cashfree.com
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX # set to PRODUCTION for live gateway
